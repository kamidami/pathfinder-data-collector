PATHFINDER_COLLECTOR_DATABASE_URL=sqlite:///var/collector.db
PATHFINDER_COLLECTOR_EXPORT_DIR=var/exports
PATHFINDER_COLLECTOR_CACHE_DIR=var/cache
PATHFINDER_COLLECTOR_REPORT_DIR=var/reports
PATHFINDER_COLLECTOR_LOG_LEVEL=INFO
PATHFINDER_COLLECTOR_USER_AGENT=PathfinderCollector/0.2 (+public-data-research)
PATHFINDER_COLLECTOR_CONNECT_TIMEOUT_SECONDS=10
PATHFINDER_COLLECTOR_READ_TIMEOUT_SECONDS=30
PATHFINDER_COLLECTOR_MAX_RESPONSE_BYTES=5242880
PATHFINDER_COLLECTOR_MAX_REDIRECTS=5
PATHFINDER_COLLECTOR_MIN_HOST_DELAY_SECONDS=1.0
PATHFINDER_COLLECTOR_CACHE_TTL_HOURS=24
PATHFINDER_COLLECTOR_ROBOTS_CACHE_TTL_HOURS=24
PATHFINDER_COLLECTOR_ALLOWED_CONTENT_TYPES=text/html,text/plain,application/xhtml+xml,application/xml,text/xml,application/gzip,application/x-gzip
PATHFINDER_COLLECTOR_DISCOVERY_MAX_PAGES_PER_DOMAIN=20
PATHFINDER_COLLECTOR_DISCOVERY_MAX_CRAWL_DEPTH=2
PATHFINDER_COLLECTOR_DISCOVERY_MAX_LINKS=1000
PATHFINDER_COLLECTOR_DISCOVERY_MAX_SITEMAPS=25
PATHFINDER_COLLECTOR_DISCOVERY_MAX_SITEMAP_DEPTH=2
